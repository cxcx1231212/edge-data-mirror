{
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:crypto": "tsc -p tsconfig.client.json",
    "build": "pnpm run typecheck && pnpm run build:crypto && wrangler deploy --dry-run --config wrangler.jsonc --outdir dist",
    "test:crypto": "pnpm run build:crypto && node tests/crypto.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0"
  }
}
